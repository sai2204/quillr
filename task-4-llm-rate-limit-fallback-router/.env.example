# port the rate-limit/failover gateway's HTTP server listens on
GATEWAY_PORT=6000

# port the mock primary provider listens on
PRIMARY_PORT=6100

# port the mock secondary (fallback) provider listens on
SECONDARY_PORT=6200

# full URL (including path) the router calls first, with a 3000ms budget
PRIMARY_URL=http://localhost:6100/v1/complete

# full URL (including path) the router falls back to on primary failure/timeout
SECONDARY_URL=http://localhost:6200/v1/complete

# filesystem path to the on-disk SQLite file backing the sliding-window rate limiter
RATE_LIMIT_DB_PATH=./rate_limit.db
