# port the gateway (proxy) HTTP server listens on
GATEWAY_PORT=4000

# port the mock downstream MCP server listens on
DOWNSTREAM_PORT=4100

# base URL the gateway forwards tools/list and tools/call requests to
DOWNSTREAM_URL=http://localhost:4100

# HMAC secret used to sign/verify the bearer JWTs carrying the role claim
# (used by both the gateway's verifier and the mint-token.ts helper script)
JWT_SECRET=dev-secret-change-me
